ar(remito): void&lt;br/&gt;+recibir(remito): void&lt;br/&gt;+cancelar(remito, motivo): void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#8BBF2F;fillColor=#EEF8D8;strokeWidth=2;fontColor=#1b1b1b;" vertex="1" parent="1"><mxGeometry x="335" y="1227" width="285" height="143" as="geometry"/></mxCell><mxCell id="despachado" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Despachado&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+agregar_ejemplar(remito, ejemplar): void&lt;br/&gt;+empaquetar(remito): void&lt;br/&gt;+despachar(remito): void&lt;br/&gt;+recibir(remito): void&lt;br/&gt;+cancelar(remito, motivo): void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#1B9AC9;fillColor=#E1F3FA;strokeWidth=2;fontColor=#1b1b1b;" vertex="1" parent="1"><mxGeometry x="640" y="1227" width="285" height="143" as="geometry"/></mxCell><mxCell id="recibido" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Recibido&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:6px;"&gt;+agregar_ejemplar(remito, ejemplar): void&lt;br/&gt;+empaquetar(remito): void&lt;br/&gt;+despachar(remito): void&lt;br/&gt;+recibir(remito): void&lt;br/&gt;+cancelar(remito, motivo): void&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;strokeColor=#D9534F;fillColor=#FDE9E8;strokeWidth=2;fontColor=#1b1b1b;" vertex="1" parent="1"><mxGeometry x="945" y="1227" width="285" height="143" as="geometry"/></mxCell><mxCell id="cancelado" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Canc